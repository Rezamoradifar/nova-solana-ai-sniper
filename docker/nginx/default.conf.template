# nginx's image renders this template at startup, substituting ${DOMAIN} from
# the environment (set DOMAIN in .env). First-time HTTPS setup:
#   ./scripts/init-letsencrypt.sh <domain> <email>

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Until a certificate exists, serve traffic directly instead of redirecting
    # to HTTPS (avoids a redirect loop on first boot, before certbot has run).
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 5m;

    # REST + websocket API
    location /api/ {
        proxy_pass http://api:4000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # NOVA_TELEGRAM_MINIAPP_DISABLED_BEGIN
    location = /app {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 410 "Telegram Mini App is disabled.\n";
    }

    location ^~ /app/ {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 410 "Telegram Mini App is disabled.\n";
    }

    location = /api/auth/telegram {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 410 '{"code":"MINIAPP_DISABLED","error":"Telegram Mini App is disabled."}';
    }

    location = /api/auth/telegram/ {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 410 '{"code":"MINIAPP_DISABLED","error":"Telegram Mini App is disabled."}';
    }
    # NOVA_TELEGRAM_MINIAPP_DISABLED_END

    # Dashboard static build — baked into this image by apps/dashboard/Dockerfile.
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
