# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
LOG_LEVEL=info

# --- Core infra (required) ---
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_sniper
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# --- Auth / secrets (required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Solana / RPC (optional, falls back to public mainnet RPC) ---
# Provider priority (see apps/api/src/solana/connection.ts's resolveAllRpcEndpoints):
# QuickNode > Helius > Chainstack > ADDITIONAL_RPC_URLS > SOLANA_RPC_URL > public.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=
# Any of these additional RPC providers can be set to add more load-balanced/
# failover capacity (see apps/api/src/solana/connection.ts) — all optional.
QUICKNODE_RPC_URL=
QUICKNODE_WS_URL=
CHAINSTACK_RPC_URL=
# Comma-separated list of any further RPC endpoints (self-hosted, Ankr, Triton, ...)
ADDITIONAL_RPC_URLS=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEYPAIR=

# --- Real on-chain referral/platform payout (2026-07-23) — see
# apps/api/src/business/payoutExecutor.ts. REQUIRED: a real base58 Solana
# public key you (the operator) control — the API refuses to boot without a
# valid one here. Never generate or invent this value in code.
PLATFORM_TREASURY_WALLET_ADDRESS=
# How stale a stuck PayoutAttempt (PENDING/SUBMITTED) can get before it's
# flagged for manual reconciliation instead of treated as still in-flight.
PAYOUT_ATTEMPT_STALE_MS=600000

# --- Staged profitability improvements (all optional, default false = today's
# unchanged behavior). Each is a master switch; a SnipeConfig's own matching
# opt-in field must ALSO be true before that logic runs for that config. ---
ENTRY_FILTER_ENABLED=false
DYNAMIC_SIZING_ENABLED=false
PARTIAL_EXITS_ENABLED=false
BEST_ROUTE_EXECUTION_ENABLED=false

# Smart Money + Early Pump Detection (shadow-mode only — see
# smartMoneyMomentumEvaluator.ts). SMART_MONEY_ANALYSIS_ENABLED/
# EARLY_MOMENTUM_DETECTION_ENABLED default false (no new RPC/DexScreener work
# until deliberately turned on); SHADOW_MODE_ENABLED defaults true (pure
# logging, never gates a real trade). No production auto-buy path exists for
# these signals yet.
SMART_MONEY_ANALYSIS_ENABLED=false
EARLY_MOMENTUM_DETECTION_ENABLED=false
SHADOW_MODE_ENABLED=true

# Two-stage discovery pipeline: bounds concurrent Stage-1->Stage-2 workers and
# concurrent AI-provider calls, and the momentum thresholds for FAST PATH
# queue priority (never a security bypass — see candidatePipeline.ts).
DISCOVERY_QUEUE_CONCURRENCY=8
AI_QUEUE_CONCURRENCY=3
FAST_PATH_MIN_RECENT_BUYS=15
FAST_PATH_MIN_RECENT_VOLUME_USD=2000

# Massive Scanner Scalability: periodically re-tunes discoveryQueue's
# concurrency between Min/Max instead of leaving it fixed at
# DISCOVERY_QUEUE_CONCURRENCY forever — scales up while backlogged and RPC/
# event-loop are healthy, scales down the moment either isn't.
SCANNER_CONCURRENCY_GOVERNOR_ENABLED=true
SCANNER_CONCURRENCY_GOVERNOR_INTERVAL_MS=10000
SCANNER_CONCURRENCY_MIN=2
SCANNER_CONCURRENCY_MAX=24
SCANNER_EVENT_LOOP_LAG_CEILING_MS=200

# Pump.fun launch-detection fault tolerance (2026-07-23, recurring silent-drop
# incident follow-up — see pumpfun.ts's PumpFunMonitor and scannerHealth.ts).
# All optional with safe defaults; no change required to deploy.
PUMPFUN_RESUBSCRIBE_INTERVAL_MS=0
PUMPFUN_LAUNCH_SILENCE_ALERT_MS=1500000
PUMPFUN_WATCHDOG_VERIFY_WINDOW_MS=30000
PUMPFUN_PROVIDER_COOLDOWN_BASE_MS=30000
PUMPFUN_PROVIDER_COOLDOWN_MAX_MS=300000
PUMPFUN_PRIMARY_RECOVERY_PROBE_INTERVAL_MS=300000
FALLBACK_DISCOVERY_IDLE_INTERVAL_MS=60000
# 2026-07-27 "unblock buys" audit: how long (ms) after detection a PUMPFUN
# candidate is exempt from the DexScreener-listing and minimum-holder-count
# checks (candidatePipeline.ts/criticalSecurityGate.ts) — every other check
# still applies unconditionally. 0 disables the grace period entirely.
PUMPFUN_GRACE_PERIOD_MS=150000
FALLBACK_DISCOVERY_MAX_LOOKBACK_MS=7200000
SCANNER_HEALTH_CHECK_INTERVAL_MS=30000
# true: an UNHEALTHY-triggered auto-buy pause clears itself once detection is
# HEALTHY again. false: an admin must clear it with /resumeautobuy.
SCANNER_AUTO_BUY_AUTO_RESUME_ENABLED=true

# EmergencyExitMonitor — Institutional Mode's safety net (force-closes an OPEN
# institutional-mode position on a detected liquidity-removal/rug signal).
# Currently a no-op even when enabled: institutional mode has no wiring on the
# position-open side yet, so no position ever has institutionalModeEnabled set.
EMERGENCY_EXIT_ENABLED=false
EMERGENCY_EXIT_CHECK_INTERVAL_MS=45000

# Telegram Member Counter — how often memberGrowthReporter.ts polls the total
# registered-bot-user count and sends a batched "+N members" owner notification
# for any increase, plus milestone alerts (100/500/1k/5k/10k/25k/50k/100k members).
MEMBER_GROWTH_REPORT_INTERVAL_MS=300000

# Dynamic Risk Tiers / bundled-wallet detection / extreme-pump protection
# (2026-07-23, USOH incident follow-up). Always active (not a staged opt-in
# flag) — every value here is a multiplier/percentage/duration applied to a
# user's own configured buyAmountSol, never a hardcoded absolute SOL size.
RISK_TIER_ULTRA_EARLY_MAX_AGE_MS=300000
RISK_TIER_EARLY_MAX_AGE_MS=900000
RISK_TIER_ULTRA_EARLY_SIZE_BPS=2500
RISK_TIER_EARLY_SIZE_BPS=5000
RISK_TIER_ESTABLISHED_SIZE_BPS=10000
BUNDLE_CLUSTER_SIMILARITY_TOLERANCE_BPS=300
BUNDLE_CLUSTER_MIN_WALLET_COUNT=4
BUNDLE_CLUSTER_MIN_SUPPLY_PERCENT=3
EXTREME_PUMP_H1_THRESHOLD_PERCENT=500
# How many consecutive "no Jupiter route exists" SELL failures a position may
# accumulate before it's marked permanently unsellable and stops being retried.
SELL_MAX_PERMANENT_ROUTE_RETRIES=3
# Exponential backoff between those retries — wait after the 1st failure, then
# doubles each subsequent failure up to the Max, instead of retrying on the
# very next price tick with zero delay.
SELL_PERMANENT_RETRY_BACKOFF_BASE_MS=60000
SELL_PERMANENT_RETRY_BACKOFF_MAX_MS=1800000

# --- AI providers (at least one required for AI scoring/marketing) ---
# ANTHROPIC_API_KEY/OPENAI_API_KEY: trading single-provider fallback (used
# only when OPENROUTER_API_KEY below is unset — see apps/api/src/worker.ts).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY is used ONLY by apps/marketing-engine (content + optional
# image generation, see MARKETING_AI_IMAGE_ENABLED below) — it has no effect
# anywhere in the trading app (apps/api); GEMINI_API_KEY isn't even part of
# apps/api's config schema (2026-07-27, full removal from the trading
# pipeline — see packages/ai/src/consensus.ts). Leave unset if you don't run
# the marketing engine.
GEMINI_API_KEY=
# Multi-LLM consensus: set OPENROUTER_API_KEY to enable the consensus gate
# (see packages/ai/src/consensus.ts). OPENROUTER_MODEL's default is verified
# against OpenRouter's live model catalog at implementation time — override
# only with a model you've confirmed works on your account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Self-hosted Ollama: optional second consensus vote alongside OpenRouter (see
# packages/ai/src/consensus.ts). Either provider being temporarily unreachable
# never blocks or delays a BUY on its own — the gate falls back to a decision
# from whichever one is available.
OLLAMA_HOST=
OLLAMA_MODEL=
# Weighted confidence floor (0-100) the consensus vote must clear before
# AutoTrader runs (see packages/ai/src/consensus.ts). Default 70; was 85 until
# the 2026-07-27 "unblock buys" audit.
CONSENSUS_MIN_WEIGHTED_CONFIDENCE=70

# --- Telegram (required for bot features) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated list allowed, e.g. two admins: 111,222
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
# Set true to make the bot unusable by anyone whose id isn't in
# TELEGRAM_ADMIN_IDS above (every other update, including /start, is
# dropped before any handler runs). Default false = open to any Telegram
# user, same as before this flag existed.
TELEGRAM_PRIVATE_MODE=false
# Public broadcast channel for apps/marketing-engine (e.g. "@yourchannel") —
# the bot above must be added there as an admin with post permission.
# Falls back to TELEGRAM_CHAT_ID when unset.
MARKETING_TELEGRAM_CHANNEL_ID=
# AI-generated visual background for eligible posts (requires GEMINI_API_KEY
# on a billing-enabled project) — the branded template renderer always works
# regardless of this flag, so this is purely an optional enhancement.
MARKETING_AI_IMAGE_ENABLED=false
# Daily Trade Showcase (apps/marketing-engine) — publishes every real
# (non-paper), non-honeypot-flagged closed trade plus a daily aggregate
# summary to MARKETING_TELEGRAM_CHANNEL_ID. Off by default: posts real trade
# data (mint addresses, tx signatures, PnL) to a public channel automatically.
# TRADE_SHOWCASE_DEPLOYED_AT must be set once and then left alone (falls back
# to "now" at each boot if unset) — see env.ts's own doc comment.
TRADE_SHOWCASE_ENABLED=false
TRADE_SHOWCASE_POLL_INTERVAL_MS=900000
TRADE_SHOWCASE_MAX_POSTS_PER_TICK=3
TRADE_SHOWCASE_DEPLOYED_AT=
# Durable Telegram broadcast queue worker (apps/marketing-engine) — how often
# BroadcastWorker drains TradeBroadcast/TradeBroadcastDelivery rows. Only
# runs when TRADE_SHOWCASE_ENABLED=true (its only current producer).
BROADCAST_WORKER_INTERVAL_MS=5000
# Real-data Telegram activity feed (apps/marketing-engine) — posts New
# Opportunity, Market Activity, Trending Token, Whale Alert, Security Alert,
# and Weekly Summary messages sourced only from real DB rows + real public
# DexScreener enrichment, never simulated content. Off by default.
ACTIVITY_FEED_ENABLED=false
ACTIVITY_FEED_MIN_INTERVAL_MINUTES=15
ACTIVITY_FEED_MAX_INTERVAL_MINUTES=120
ACTIVITY_FEED_MAX_POSTS_PER_DAY=20
ACTIVITY_FEED_DEPLOYED_AT=
ACTIVITY_FEED_TRENDING_MIN_H1_CHANGE_PERCENT=15
# Durable admin-broadcast queue worker (apps/marketing-engine) — how often
# AdminBroadcastWorker drains AdminBroadcast/AdminBroadcastDelivery rows
# enqueued by the durableBroadcast.ts CLI script. Runs unconditionally
# whenever a bot+DB are configured; only ever has work when an operator
# explicitly enqueues a one-off announcement.
ADMIN_BROADCAST_WORKER_INTERVAL_MS=5000
# Ecosystem Feed (apps/marketing-engine) — posts ecosystem-wide Trending
# Tokens/Smart Money Trades/High Volume Tokens/Hidden Gems/Biggest Winners
# content with a generated stat-card image and buttons. Separate env
# namespace from TELEGRAM_TREND_* (that source feeds apps/api's live
# buy-candidate pipeline; this one feeds only outbound marketing content).
# Off by default, same double-opt-in convention as TRADE_SHOWCASE_ENABLED/
# ACTIVITY_FEED_ENABLED.
ECOSYSTEM_FEED_ENABLED=false
ECOSYSTEM_FEED_TELEGRAM_CHANNELS=soltrenchtrending,trendingssol,solwhaletrending
ECOSYSTEM_FEED_POLL_INTERVAL_MS=60000
ECOSYSTEM_FEED_MAX_CANDIDATES_PER_TICK=5
ECOSYSTEM_FEED_MIN_LIQUIDITY_USD=5000
ECOSYSTEM_FEED_MIN_RISK_SCORE=50
ECOSYSTEM_FEED_MAX_POSTS_PER_TICK=3
ECOSYSTEM_FEED_MIN_VOLUME_USD=50000
ECOSYSTEM_FEED_MAX_HIDDEN_GEM_MARKET_CAP_USD=200000
ECOSYSTEM_FEED_DEPLOYED_AT=
# Network Trade Feed (apps/marketing-engine) — curated feed of OTHER real
# wallets' completed trades (never this bot's own — see TRADE_SHOWCASE_ENABLED
# for that separate category), sourced only from SmartWalletTokenEntry rows
# resolved to a real, on-chain-verified full exit. Off by default. Posts only
# the single best unposted eligible trade per tick (never every real backlog
# item), picked by data.ts's compareNetworkTradeCandidatesByPriority: Trending
# Tokens > Smart Money > Whale Wallets > Highest ROI > Highest PnL
# (2026-08-05 spec). Quality gate (isNetworkTradeCandidateEligible) prefers
# profitable trades, accepts small losses, and skips likely rugs/spam via ROI
# floor + wallet rug-exposure/Sybil signals; duplicate wallets are cooled down
# in-memory in monitor.ts. Cadence below targets "about 2 posts/hour" with
# natural random pacing (never a fixed interval, never the same time twice);
# MAX_POSTS_PER_DAY is an extra overall ceiling, never a floor.
NETWORK_TRADE_FEED_ENABLED=false
NETWORK_TRADE_FEED_MIN_INTERVAL_MINUTES=20
NETWORK_TRADE_FEED_MAX_INTERVAL_MINUTES=40
NETWORK_TRADE_FEED_MAX_POSTS_PER_DAY=48
NETWORK_TRADE_FEED_DEPLOYED_AT=
# How often NetworkTradeBroadcastWorker drains the DM-to-every-registered-user
# queue (see networkTradeFeed/broadcastQueue.ts) — "bot and channel get
# identical posts". Only has work when NETWORK_TRADE_FEED_ENABLED is on.
NETWORK_TRADE_BROADCAST_WORKER_INTERVAL_MS=5000
# Network Trade Scanner (apps/api) — off by default. Broadens which mints
# feed the smart-wallet exit pipeline beyond the live pre-migration pump.fun
# candidate flow, so the Network Trade Feed above has real completed trades
# across every DEX (PUMPFUN/PUMPSWAP/RAYDIUM/ORCA/METEORA/JUPITER) to draw
# from, not just pump.fun. Adds real, bounded RPC load — watch quota before
# enabling.
NETWORK_TRADE_SCANNER_ENABLED=false
NETWORK_TRADE_SCANNER_BATCH_SIZE=6
NETWORK_TRADE_SCANNER_INTERVAL_MS=240000
NETWORK_TRADE_SCANNER_MIN_LIQUIDITY_USD=2000
# How far back (by Token.firstSeenAt, i.e. discovery time — a proxy, not the
# real signal) a token stays eligible as a scan candidate. Raise this if the
# live discovery pipeline has fallen behind and 48h leaves too few real
# candidates for the feed to draw from.
NETWORK_TRADE_SCANNER_LOOKBACK_HOURS=48

# --- Twitter / X (optional; TWITTER_BEARER_TOKEN alone enables the read-only
# monitor via API v2 recent search — requires at least the Basic API tier,
# the free tier has no search access. The other four are unused by the
# monitor today; kept for a future posting/cross-post integration.) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERY=(pump.fun OR "solana memecoin" OR $$SOL) -is:retweet lang:en
TWITTER_POLL_INTERVAL_MS=60000

# --- Telegram trend channels (optional signal source; no bot membership or
# login needed, reads each channel's public https://t.me/s/<channel> preview.
# Master switch off by default — a mint found here still passes through the
# same risk/AI/safety pipeline as any on-chain detection.) ---
TELEGRAM_TREND_SOURCE_ENABLED=false
TELEGRAM_TREND_CHANNELS=trendingssol,trending
TELEGRAM_TREND_POLL_INTERVAL_MS=20000
TELEGRAM_TREND_MIN_AI_SCORE=50

# --- Notify gate: minimum bar for a token to get a Telegram notification at
# all, applied to every detection source. Does not affect auto-buy gating
# (SnipeConfig has its own thresholds for that). ---
NOTIFY_MIN_LIQUIDITY_USD=500
NOTIFY_MIN_AI_SCORE=50

# --- Market data ---
DEXSCREENER_API_BASE=https://api.dexscreener.com
JUPITER_API_BASE=https://lite-api.jup.ag
