# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
LOG_LEVEL=info

# --- Core infra (required) ---
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_sniper
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# --- Auth / secrets (required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Solana / RPC (optional, falls back to public mainnet RPC) ---
# Provider priority (see apps/api/src/solana/connection.ts's resolveAllRpcEndpoints):
# QuickNode > Helius > Chainstack > ADDITIONAL_RPC_URLS > SOLANA_RPC_URL > public.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=
# Any of these additional RPC providers can be set to add more load-balanced/
# failover capacity (see apps/api/src/solana/connection.ts) — all optional.
QUICKNODE_RPC_URL=
QUICKNODE_WS_URL=
CHAINSTACK_RPC_URL=
# Comma-separated list of any further RPC endpoints (self-hosted, Ankr, Triton, ...)
ADDITIONAL_RPC_URLS=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEYPAIR=

# --- Staged profitability improvements (all optional, default false = today's
# unchanged behavior). Each is a master switch; a SnipeConfig's own matching
# opt-in field must ALSO be true before that logic runs for that config. ---
ENTRY_FILTER_ENABLED=false
DYNAMIC_SIZING_ENABLED=false
PARTIAL_EXITS_ENABLED=false
BEST_ROUTE_EXECUTION_ENABLED=false

# --- AI providers (at least one required for AI scoring/marketing) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Telegram (required for bot features) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# --- Twitter / X (optional; TWITTER_BEARER_TOKEN alone enables the read-only
# monitor via API v2 recent search — requires at least the Basic API tier,
# the free tier has no search access. The other four are unused by the
# monitor today; kept for a future posting/cross-post integration.) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_SEARCH_QUERY=(pump.fun OR "solana memecoin" OR $SOL) -is:retweet lang:en
TWITTER_POLL_INTERVAL_MS=60000

# --- Market data ---
DEXSCREENER_API_BASE=https://api.dexscreener.com
JUPITER_API_BASE=https://lite-api.jup.ag
