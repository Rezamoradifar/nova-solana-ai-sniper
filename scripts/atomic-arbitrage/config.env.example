# Separate from Nova. DO NOT set Nova LIVE_TRADING or COPY_TRADING flags.
# Off is installed by default. 'simulate' uses public addresses only, NEVER a signer.
ARB_MODE=off
ARB_RPC_URL=
ARB_OWNER=
# Optional for limited-rate prototyping; required for reliable production API access.
ARB_JUPITER_API_KEY=
ARB_BUY_DEX=Raydium CLMM
ARB_SELL_DEX=Whirlpool
# Initial engineering ceilings, not investment recommendations. Units are lamports.
ARB_AMOUNT_LAMPORTS=10000000
ARB_MAX_AMOUNT_LAMPORTS=10000000
ARB_MAX_FEE_LAMPORTS=100000
ARB_MIN_PROFIT_LAMPORTS=50000
ARB_SOL_RESERVE_LAMPORTS=10000000
ARB_DAILY_FEE_BUDGET_LAMPORTS=100000
ARB_MAX_ATTEMPTS_PER_DAY=1
ARB_SLIPPAGE_BPS=5
ARB_MAX_QUOTE_AGE_MS=8000
ARB_CU_PRICE_MICROLAMPORTS=1000
ARB_STATE_DIR=/state
# No private key or approval is created by the installer.
ARB_KEYPAIR_FILE=
ARB_APPROVAL_FILE=
