{
  "name": "@nova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "broadcast": "dotenv -e ../../.env -- tsx scripts/broadcast.ts",
    "notify-low-balance": "dotenv -e ../../.env -- tsx scripts/notify-low-balance.ts",
    "evaluate-shadow-mode": "dotenv -e ../../.env -- tsx scripts/evaluateShadowMode.ts",
    "reconcile-pnl": "dotenv -e ../../.env -- tsx scripts/reconcilePnl.ts",
    "benchmark-scanner": "tsx scripts/benchmarkScanner.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "@nova/ai": "*",
    "@nova/shared": "*",
    "@nova/telegram-bot": "*",
    "@prisma/client": "^5.22.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "@tma.js/init-data-node": "^2.0.8",
    "bs58": "^6.0.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
