# --- Twitter / X API v2 (requires a paid Basic tier or higher for mentions/search) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Identity ---
AGENT_NAME=Nova
# Plain factual context only — never used as a solicitation/pitch, see llm/claude_client.py's system prompt.
SOLANA_WALLET_ADDRESS=

# --- Real trade data (optional) ---
# Nova's most credible content: real, verifiable trades from the actual
# Nova Solana AI Sniper trading bot's own Postgres database (the same one
# apps/api uses). Leave unset to skip trade_highlight content entirely —
# nothing else in this agent requires it.
#
# STRONGLY RECOMMENDED: point this at a read-only Postgres role (SELECT-only
# grants on positions/tokens/trades), not the trading app's own read/write
# credentials — see news/bot_trades.py's doc comment. Example:
#   TRADING_DATABASE_URL=postgresql://nova_readonly:PASSWORD@host:5432/nova
TRADING_DATABASE_URL=
BOT_PUBLIC_NAME=Nova Solana AI Sniper
# Optional link Nova can reference when talking about the bot (e.g. the
# Telegram bot or landing page). Never used with urgency/fomo framing.
BOT_REFERRAL_URL=

# --- Behavior tuning (all optional, sane defaults in core/config.py) ---
POSTS_PER_DAY_MIN=8
POSTS_PER_DAY_MAX=12
MIN_PUBLISH_SCORE=92
MAX_GENERATION_ATTEMPTS=4
MENTION_POLL_INTERVAL_SECONDS=90
TREND_POLL_INTERVAL_SECONDS=1800
NEWS_POLL_INTERVAL_SECONDS=900
MAX_HASHTAGS=2

# Comma-separated list of RSS feed URLs to override the built-in defaults.
# NEWS_FEED_URLS=

# --- Storage ---
DB_PATH=/data/memory.sqlite3
REDIS_URL=

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
