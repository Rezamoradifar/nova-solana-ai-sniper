{
  "name": "@nova/marketing-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "send-test-post": "dotenv -e ../../.env -- tsx scripts/sendTestPost.ts",
    "dry-run-visuals": "dotenv -e ../../.env -- tsx scripts/dryRunVisualPosts.ts",
    "durable-broadcast": "dotenv -e ../../.env -- tsx scripts/durableBroadcast.ts"
  },
  "dependencies": {
    "@nova/ai": "*",
    "@nova/shared": "*",
    "@nova/telegram-bot": "*",
    "@prisma/client": "^5.22.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "grammy": "^1.32.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
